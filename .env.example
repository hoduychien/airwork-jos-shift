# Sao chép thành .env rồi điền giá trị từ Supabase Dashboard → Settings → API
# Bỏ trống cả hai để chạy CHẾ ĐỘ DEMO (dữ liệu lưu localStorage, không cần backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Domain email cho tài khoản nhân viên ở chế độ Supabase (<mã nhân viên>@domain). Mặc định fpt.com
VITE_ACCOUNT_EMAIL_DOMAIN=fpt.com
